# Production environment template.
# Copy this file to `.env.production` and fill in real values:
#   cp .env.production.example .env.production
#
# Vite loads `.env.production` during `vite build` (production mode).
# Only VITE_-prefixed vars are exposed to the client bundle, so put NO secrets here.

# Base URL for the staff API (must include the /api path).
VITE_API_URL=https://your-production-api.example.com/api
