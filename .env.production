# Production environment — loaded by Vite during `vite build` (production mode).
# Only VITE_-prefixed vars are exposed to the client bundle, so put NO secrets here.

# Base URL for the staff API (must include the /api path).
# Point this at your PRODUCTION API host before deploying.
VITE_API_URL=https://staff-app-api-gvq3.onrender.com/api
